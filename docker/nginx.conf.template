events {
    worker_connections 1024;
}

http {
    include       /etc/nginx/mime.types;
    default_type  application/octet-stream;
    sendfile        on;
    keepalive_timeout 65;

    map $http_upgrade $connection_upgrade {
        default upgrade;
        ''      close;
    }

    server {
        listen $PORT;
        server_name _;

        resolver 8.8.8.8 1.1.1.1 valid=300s;
        resolver_timeout 5s;

        # Catch Reverb WebSocket connections (supports /api/gps/app/... and /app/...)
        location ~ ^/(api/gps/)?app/(.*)$ {
            # Rewrite to always send /app/{key} to the GPS microservice on Render
            proxy_pass ${GPS_SERVICE_URL}/app/$2$is_args$args;
            
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            
            proxy_set_header Host ${GPS_SERVICE_HOST};
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto https;

            # SSL Handshake necessary for Render
            proxy_ssl_server_name on;

            # Extended timeouts and buffering disabled to maintain persistent connection
            proxy_buffering off;
            proxy_read_timeout 86400s;
            proxy_send_timeout 86400s;
        }

        # REST API routes for the GPS microservice (supports /api/gps/...)
        location /api/gps/ {
            rewrite ^/api/gps/(.*)$ /$1 break;

            proxy_pass ${GPS_SERVICE_URL};
            proxy_set_header Host ${GPS_SERVICE_HOST};
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto https;
            
            proxy_ssl_server_name on;
        }

        # Local routes for the API Gateway (Laravel)
        location / {
            proxy_pass http://127.0.0.1:8000;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }
    }
}