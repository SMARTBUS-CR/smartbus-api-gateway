events {
    worker_connections 1024;
}

http {
    include       /etc/nginx/mime.types;
    default_type  application/octet-stream;
    sendfile        on;
    keepalive_timeout 65;

    map $http_upgrade $connection_upgrade {
        default upgrade;
        ''      close;
    }

    server {
        listen $PORT;
        server_name _;

        resolver 8.8.8.8 1.1.1.1 valid=300s;
        resolver_timeout 5s;

        # 1. Captura conexiones WebSocket de Reverb (soporta /api/gps/app/... y /app/...)
        location ~ ^/(api/gps/)?app/(.*)$ {
            # Se reescribe para enviar siempre /app/{key} al microservicio GPS en Render
            proxy_pass https://smartbus-gps-tracking.onrender.com/app/$2$is_args$args;
            
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            
            proxy_set_header Host smartbus-gps-tracking.onrender.com;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto https;

            # Handshake SSL necesario para Render
            proxy_ssl_server_name on;

            # Timeouts extendidos y buffering desactivado para mantener la conexión persistente
            proxy_buffering off;
            proxy_read_timeout 86400s;
            proxy_send_timeout 86400s;
        }

        # 2. Rutas REST del Microservicio GPS
        location /api/gps/ {
            rewrite ^/api/gps/(.*)$ /$1 break;

            proxy_pass https://smartbus-gps-tracking.onrender.com;
            proxy_set_header Host smartbus-gps-tracking.onrender.com;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto https;
            
            proxy_ssl_server_name on;
        }

        # 3. Rutas locales del API Gateway (Laravel)
        location / {
            proxy_pass http://127.0.0.1:8000;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }
    }
}